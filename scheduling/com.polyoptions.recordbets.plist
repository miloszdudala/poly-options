<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polyoptions.recordbets</string>

    <!-- Adds bets to BETS.md on main and pushes. Every five minutes because a
         snapshot takes two to seven minutes and a bet should be pushed as soon
         as it finishes; with no new cycle the job exits at once. -->
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>__REPO__/model/record_bets.py</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/launchd-recordbets.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/launchd-recordbets.err</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
