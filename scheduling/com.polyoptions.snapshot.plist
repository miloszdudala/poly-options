<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polyoptions.snapshot</string>

    <!-- Fires on the quarter hour, around the clock; the job itself decides
         whether to collect (NYSE session only) and exits in ~2 s otherwise.

         Deliberately NOT StartInterval. launchd does not start counting an
         interval until the job exits, so a 150 s run pushed every tick 150 s
         later: measured gaps of 17.0-18.0 min against a nominal 15, which cost
         5 of 26 snapshots per session and left cycles at drifting clock times
         that cannot be lined up across days. Calendar entries are absolute, so
         a slow run delays only itself. launchd will not start a second copy
         while one is still running, it defers to the next slot. -->
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>__REPO__/data/src/jobs.py</string>
        <string>snapshot</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/launchd-snapshot.out</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/launchd-snapshot.err</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
